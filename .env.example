FAMILY_AGENT_DB=./data/family-repurchase.sqlite

# 网页复购助手的 OpenAI-compatible 模型配置
FAMILY_AGENT_ASSISTANT_BASE_URL=
FAMILY_AGENT_ASSISTANT_MODEL=
FAMILY_AGENT_ASSISTANT_API_KEY=

;LLM API Key
NORMALIZATION_LLM_API_KEY=

# 订单截图视觉模型使用独立配置，归一化模型密钥不会自动用于截图识别
FAMILY_AGENT_PARSE_ORDER_IMAGE_MODEL_API_KEY=

# 本地 OCR 的 Python 和脚本路径；服务器可改为虚拟环境及部署脚本的绝对路径
FAMILY_AGENT_LOCAL_OCR_EXECUTABLE=python
FAMILY_AGENT_LOCAL_OCR_SCRIPT=scripts/local-ocr.py
